# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Database
# MONGODB_URI=mongodb://localhost:27017/hotel-booking

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
COOKIE_SECRET=replace_with_another_long_random_string

# Payments - Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Payments - Flutterwave (alternative, optional)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Which gateway is active: paystack | flutterwave
PAYMENT_PROVIDER=paystack

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Hotel Booking
HOTEL_EMAIL=admin@example.com

# Image storage - Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin seed (used only by seed script)
FIRST_ADMIN_NAME=Super Admin
FIRST_ADMIN_EMAIL=admin@hotel.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
